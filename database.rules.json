{
  "rules": {
    ".read": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val())",
    ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val())",
    "users": {
      ".read": "auth != null && ((auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val()) || root.child('users').child(auth.uid).child('role').val() === 'coadmin')",
      "$uid": {
        ".read": "auth != null && ((auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val()) || root.child('users').child(auth.uid).child('role').val() === 'coadmin' || auth.uid === $uid)",
        ".write": "auth != null && ((auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val()) || (auth.uid === $uid && !data.exists() && newData.child('wallet').val() === 0 && !newData.child('role').exists()))",
        "wallet": {
          ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || (auth.uid === $uid && data.exists() && data.isNumber() && newData.isNumber() && newData.val() < data.val()))",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "role": {
          ".write": "auth != null && auth.token.email === 'sahidkhanmewati02@gmail.com'",
          ".validate": "newData.val() === 'coadmin' || newData.val() === 'player'"
        },
        "ign": {
          ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === $uid)"
        },
        "bgmiId": {
          ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === $uid)"
        },
        "txns": {
          ".read": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === $uid)",
          "$txnId": {
            ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || (auth.uid === $uid && !data.exists()))"
          }
        }
      }
    },
    "matches": {
      ".read": "auth != null",
      "$matchId": {
        ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin')",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin' || (auth.uid === $uid && !data.exists() && ((root.child('matches').child($matchId).child('mode').val() === 'SQUAD' && newData.child('teamSize').val() === 4) || (root.child('matches').child($matchId).child('mode').val() === 'DUO' && newData.child('teamSize').val() === 2) || (root.child('matches').child($matchId).child('mode').val() !== 'SQUAD' && root.child('matches').child($matchId).child('mode').val() !== 'DUO' && newData.child('teamSize').val() === 1)) && newData.child('baseFee').val() === root.child('matches').child($matchId).child('fee').val() * newData.child('teamSize').val() && newData.child('feePaid').val() === newData.child('baseFee').val() && (root.child('matches').child($matchId).child('adminSelectionEnabled').val() !== true || (newData.child('selectedAdminUid').isString() && newData.child('selectedAdminUid').val().length > 0 && root.child('matches').child($matchId).child('votingAdmins').hasChildren()))))",
            "slotNumber": {
              ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin')",
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0"
            },
            "members": {
              "$index": {
                ".validate": "newData.hasChildren(['ign','bgmiId'])"
              }
            },
            ".validate": "newData.hasChildren(['ign','bgmiId']) && (!newData.child('slotNumber').exists() || (newData.child('slotNumber').isNumber() && newData.child('slotNumber').val() >= 1 && newData.child('slotNumber').val() % 1 === 0)) && (!newData.child('teamSize').exists() || (newData.child('teamSize').isNumber() && (newData.child('teamSize').val() === 1 || newData.child('teamSize').val() === 2 || newData.child('teamSize').val() === 4))) && (!newData.child('baseFee').exists() || newData.child('baseFee').isNumber()) && (!newData.child('feePaid').exists() || newData.child('feePaid').isNumber())"
          }
        },
        "joined": {
          ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin' || (newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1 && newData.val() <= root.child('matches').child($matchId).child('slots').val()))"
        }
      }
    },
    "usedUtrs": {
      ".read": "auth != null && auth.token.email === 'sahidkhanmewati02@gmail.com'",
      "$utr": {
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid', 'depositId', 'createdAt'])"
      }
    },
    "deposits": {
      ".read": "auth != null && auth.token.email === 'sahidkhanmewati02@gmail.com'",
      "$id": {
        ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'PENDING'))"
      }
    },
    "withdrawals": {
      ".read": "auth != null && auth.token.email === 'sahidkhanmewati02@gmail.com'",
      "$id": {
        ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'PENDING' && newData.child('amt').val() >= 50))"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val())"
    },
    "match_hisaab": {
      ".read": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val())",
      ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || auth.uid === root.child('config').child('superAdminUid').val())"
    },
    "chatModeration": {
      ".read": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin')",
      "$uid": {
        ".read": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin' || auth.uid === $uid)",
        ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'coadmin')"
      }
    },
    "chat": {
      ".read": "auth != null",
      "$messageId": {
        ".write": "auth != null && (auth.token.email === 'sahidkhanmewati02@gmail.com' || (!data.exists() && newData.child('uid').val() === auth.uid && newData.child('role').val() === (root.child('users').child(auth.uid).child('role').val() === 'coadmin' ? 'coadmin' : 'player')))"
      }
    }
  }
}
